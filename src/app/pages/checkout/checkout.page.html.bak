<!-- Title only. Back moved to the pay bar at the bottom, where the thumb
     already is — and where it sits beside the action it is an alternative to. -->
<ion-header class="ion-no-border co-header">
  <ion-toolbar>
    <ion-title>Checkout</ion-title>
  </ion-toolbar>
</ion-header>

<ion-content *ngIf="draft() as d">
  <!-- Checkout displays the draft from BookingService; no draft means no order to pay for. -->
  <div class="co-body" *ngIf="quote() as q">

    <!-- ── Order summary ───────────────────────────────────────────────── -->
    <!-- BookingService calculates this same quote on booking and confirmation. -->
    <p class="co-title">Order summary</p>

    <div class="co-card">
      <div class="co-trail">
        <div class="co-thumb" [style.backgroundImage]="'url(' + d.trailImage + ')'"></div>
        <div class="co-trail-meta">
          <span class="n">{{ d.trailName }}</span>
          <span class="s">{{ prettyDate() }}</span>
          <span class="s">{{ q.packageName }}</span>
        </div>
      </div>

      <div class="co-guide" *ngIf="guideName() as g">
        <span class="co-avatar">{{ g.charAt(0) }}</span>
        <span class="co-trail-meta">
          <span class="n">{{ g }}</span>
          <span class="s">Your expert guide</span>
        </span>
      </div>

      <div class="co-divider"></div>

      <div class="co-row" *ngFor="let a of q.coveredActivities">
        <span class="muted">{{ a.name }}</span>
        <span class="muted">Included</span>
      </div>

      <div class="co-row" *ngFor="let a of q.paidActivities">
        <span>{{ a.name }}</span>
        <span>₱{{ a.price | number }}</span>
      </div>

      <div class="co-row" *ngFor="let l of q.merchLines">
        <span>{{ l.name }} × {{ l.qty }}</span>
        <span>₱{{ l.lineTotal | number }}</span>
      </div>

      <div class="co-row">
        <span>Subtotal</span>
        <span>₱{{ q.subtotal | number }}</span>
      </div>

      <div class="co-row">
        <span>Transaction fee</span>
        <span>₱{{ q.transactionFee | number }}</span>
      </div>

      <div class="co-row total">
        <span>Total amount</span>
        <span>₱{{ q.total | number }}</span>
      </div>
    </div>

    <!-- ── Payment method ──────────────────────────────────────────────── -->
    <!-- Selecting a method reveals its matching form and changes pay() validation. -->
    <p class="co-title">Payment method</p>

    <div class="co-methods">
      <button
        class="co-method"
        *ngFor="let m of methods"
        [class.active]="m.id === method()"
        [class.off]="!m.available"
        (click)="selectMethod(m)"
      >
        <ion-icon [name]="m.icon"></ion-icon>
        <span>{{ m.label }}</span>
        <span class="soon" *ngIf="!m.available">Soon</span>
      </button>
    </div>

    <!-- ── Card form ───────────────────────────────────────────────────── -->
    <ng-container *ngIf="method() === 'card'">
      <label class="co-label">Card number<span class="req" aria-hidden="true">*</span></label>
      <ion-input
        class="co-input"
        inputmode="numeric"
        placeholder="0000 0000 0000 0000"
        maxlength="19"
        [value]="cardNumber"
        (ionInput)="onCardNumber($event)"
      ></ion-input>

      <div class="co-split">
        <div>
          <label class="co-label">Expiry date<span class="req" aria-hidden="true">*</span></label>
          <ion-input
            class="co-input"
            inputmode="numeric"
            placeholder="MM/YY"
            maxlength="5"
            [value]="expiry"
            (ionInput)="onExpiry($event)"
          ></ion-input>
        </div>
        <div>
          <label class="co-label">CVV<span class="req" aria-hidden="true">*</span></label>
          <ion-input
            class="co-input"
            type="password"
            inputmode="numeric"
            placeholder="123"
            maxlength="3"
            [value]="cvv"
            (ionInput)="onCvv($event)"
          ></ion-input>
        </div>
      </div>

      <label class="co-label">Cardholder name<span class="req" aria-hidden="true">*</span></label>
      <ion-input
        class="co-input"
        placeholder="Name on card"
        [(ngModel)]="cardName"
      ></ion-input>
    </ng-container>

    <!-- ── QRPh (demo) ─────────────────────────────────────────────────── -->
    <!-- The receipt preview stays local; pay() only requires it for QRPh. -->
    <ng-container *ngIf="method() === 'qrph'">
      <div class="co-alt">
        <div class="co-qr">
          <svg viewBox="0 0 25 25" role="img" aria-label="Sample QR code for the demo. It cannot be scanned.">
            <path [attr.d]="qrPath" />
          </svg>
        </div>
        <p class="co-alt-title">Scan to pay ₱{{ q.total | number }}</p>
        <p class="co-alt-text">
          Open any bank or e-wallet app that supports QRPh, scan the code and
          pay. Then upload a screenshot of your receipt below and tap Pay.
        </p>
      </div>

      <label class="co-label" for="qrph-proof">Proof of payment<span class="req" aria-hidden="true">*</span></label>
      <input
        #proofInput
        id="qrph-proof"
        class="co-file"
        type="file"
        accept="image/*"
        (change)="onProof($event)"
      />

      <button type="button" class="co-upload" *ngIf="!proof()" (click)="proofInput.click()">
        <ion-icon name="cloud-upload-outline"></ion-icon>
        <span class="t">Upload a screenshot of your payment</span>
        <span class="s">Image only (JPG or PNG), up to 5 MB</span>
      </button>

      <div class="co-proof" *ngIf="proof() as pf">
        <img [src]="pf.url" alt="Proof of payment preview" />
        <div class="co-proof-meta">
          <span class="n">{{ pf.name }}</span>
          <span class="s"><ion-icon name="checkmark-circle"></ion-icon> Uploaded · {{ pf.size }}</span>
        </div>
        <button type="button" class="co-proof-remove" aria-label="Remove proof of payment" (click)="removeProof()">
          <ion-icon name="close-outline"></ion-icon>
        </button>
      </div>
    </ng-container>

    <!-- ── Apple Pay (demo) ────────────────────────────────────────────── -->
    <ng-container *ngIf="method() === 'apple'">
      <div class="co-alt">
        <ion-icon class="co-alt-icon" name="logo-apple"></ion-icon>
        <p class="co-alt-title">Pay with Apple Pay</p>
        <p class="co-alt-text">
          Tap Pay below, then confirm with Face ID or Touch ID on your device.
        </p>
      </div>
    </ng-container>

    <!-- ── Maya (demo) ─────────────────────────────────────────────────── -->
    <ng-container *ngIf="method() === 'maya'">
      <div class="co-alt">
        <ion-icon class="co-alt-icon" name="wallet-outline"></ion-icon>
        <p class="co-alt-title">Pay with Maya</p>
        <p class="co-alt-text">
          Enter the mobile number linked to your Maya account. You will approve
          the payment in the Maya app.
        </p>
      </div>

      <label class="co-label">Maya mobile number<span class="req" aria-hidden="true">*</span></label>
      <ion-input
        class="co-input"
        type="tel"
        inputmode="numeric"
        placeholder="0917 123 4567"
        maxlength="13"
        [value]="mayaNumber"
        (ionInput)="onMayaNumber($event)"
      ></ion-input>
    </ng-container>

    <!-- This notice is not decoration. A form that looks exactly like a real
         card form should say plainly that it is not one. -->
    <div class="co-demo">
      <ion-icon name="warning-outline"></ion-icon>
      <span>
        <strong>Demo payment.</strong> No payment gateway is connected, no card
        is charged, and nothing you type here leaves this device. Only the last
        four digits are kept, for the receipt. Do not enter a real card.
      </span>
    </div>

    <div class="co-spacer"></div>
  </div>

  <!-- ── Sticky pay bar — back, pay ────────────────────────────────────── -->
  <!-- pay() confirms the booking, then routes to booking-confirmed/:id. -->
  <div class="co-footer" *ngIf="quote() as q">
    <!-- Disabled while processing: leaving halfway through a payment is the
         one thing this screen must not make easy. -->
    <button
      class="co-back"
      [disabled]="processing()"
      (click)="goBack()"
      aria-label="Go back"
    >
      <ion-icon name="arrow-back-outline"></ion-icon>
    </button>

<app-refund-policy
  [total]="quote()!.total"
  [deposit]="payNow()"
  [transactionFee]="50">
</app-refund-policy>

    <!-- pay button -->
    <button class="co-pay" [disabled]="processing()" (click)="pay()">
      <ng-container *ngIf="!processing(); else working">
        Pay ₱{{ q.total | number }}
        <ion-icon name="arrow-forward"></ion-icon>
      </ng-container>
      <ng-template #working>Processing…</ng-template>
    </button>
  </div>
</ion-content>