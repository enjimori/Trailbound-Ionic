rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Each user can only read and write their own document.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── Community ─────────────────────────────────────────────────────────
    //
    // Anyone (guests too) can read posts, comments and public profiles.
    // Writing needs an account, and every post / comment must carry the
    // writer's own uid — nobody can post or comment as someone else.

    // Public name + small photo shown beside a user's posts and comments.
    match /profiles/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 150000;
    }

    match /posts/{postId} {
      function validContent(data) {
        return data.text is string
          && data.text.size() <= 1000
          && data.images is list
          && data.images.size() <= 4
          && (data.text.size() > 0 || data.images.size() > 0)
          && (!('trailId' in data) || (data.trailId is string && data.trailId.size() <= 100))
          && (!('trailName' in data) || (data.trailName is string && data.trailName.size() <= 120))
          && data.authorName is string
          && data.authorName.size() <= 60;
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Like / unlike: the only change is adding or removing your own uid.
      function onlyToggledOwnLike() {
        let before = resource.data.likedBy.toSet();
        let after = request.resource.data.likedBy.toSet();
        return changed().hasOnly(['likedBy'])
          && request.resource.data.likedBy is list
          && after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
      }

      // Comment counter moves by exactly one, alongside adding / removing a comment.
      function onlyBumpedCommentCount() {
        return changed().hasOnly(['commentCount'])
          && request.resource.data.commentCount is int
          && (request.resource.data.commentCount - resource.data.commentCount) in [-1, 1];
      }

      // The author editing their post (text, photos, trail tag).
      function authorEdit() {
        return resource.data.authorUid == request.auth.uid
          && changed().hasOnly(['text', 'images', 'trailId', 'trailName', 'editedAt', 'authorName'])
          && request.resource.data.editedAt == request.time
          && validContent(request.resource.data);
      }

      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'authorUid', 'authorName', 'text', 'images', 'trailId', 'trailName',
             'likedBy', 'commentCount', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.likedBy == []
        && request.resource.data.commentCount == 0
        && request.resource.data.createdAt == request.time
        && validContent(request.resource.data);

      allow update: if signedIn()
        && (authorEdit() || onlyToggledOwnLike() || onlyBumpedCommentCount());

      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;

        allow create: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;

        // Your own comment, or any comment on your own post.
        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid
        );
      }
    }
  }
}
