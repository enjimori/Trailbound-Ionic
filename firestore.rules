rules_version = '2';

// ==========================================================
// Trailbound — Firestore security rules (trailbound-ionic)
// ----------------------------------------------------------
// Deploy:  firebase deploy --only firestore:rules
//   or paste into Firebase console -> Firestore Database ->
//   Rules -> Publish.
//
// STAFF ROLES — what changed in this version
//   * roleOf() reads users/{uid}.role once. Three staff roles
//     now exist beside 'admin': 'permit_office', 'guide', and
//     an ordinary hiker (no role field at all).
//   * bookings: a permit officer reads only applications that
//     TrailBound has actually SENT them (permitLodged == true)
//     and may change nothing but the permit decision. A guide
//     reads only hikes assigned to them (guideId == their own
//     roster id) and may change nothing but whether the hiker
//     turned up.
//   * certificates: a permit officer reads medical certificates,
//     because fitness to climb is the basis on which they issue.
//     They can never write one — TrailBound's review decision is
//     not theirs to change.
//   * certificate_access: NEW, append-only. Every time anyone
//     opens a medical certificate file, a line lands here. No
//     one can read it back through the app, and no one at all
//     can edit or delete a line. Read it in the Firebase console.
//   * touchesPrivilegedFields() now also covers 'office' and
//     'guideRosterId', so a guide cannot point themselves at
//     another guide's hikes and an officer cannot claim a
//     different office.
//
// ADMIN PANEL (/admin)
//   * isAdmin() recognises the built-in admin login
//     (username "admin" = trailbound.philippines@gmail.com),
//     anyone in admins/{uid}, and any hiker promoted from
//     Admin -> Staff (users/{uid}.role == 'admin').
//   * A hiker can never give themselves role or status, on
//     create or update, so nobody can self-promote or
//     un-suspend themselves.
//   * bookings: each booking carries the hiker's uid. A hiker
//     reads and creates only their own; only an admin changes
//     or deletes one.
//   * reviews, trail_status, certificates and certificate_files:
//     certificates = hiker medical certificates
//     uploads, reviewed by an admin.
//   * An admin may remove any post, comment or edit history.
//
// To add another built-in admin email, add it to the list in
// isAdmin() below AND to ADMIN_ACCOUNTS in
// src/app/pages/admin/admin.config.ts.
//
// Collections, and who each one is for:
//
//   trails     guides    packages   -> the booking page's three
//                                      dropdowns. Public read.
//   accommodations                  -> booking page Step 03:
//                                      basecamp + partner hotels.
//   products                        -> gear in the shop. Public
//                                      read when active.
//   bookings                        -> a reserved trail slot.
//   orders                          -> a paid gear/checkout order.
//   contact                         -> support messages.
//   users  (+ wishlist, notifications)
//   certificates  certificate_files  certificate_access
//   settings   activity   admins
//   guide_status  attendance        -> guide availability and the
//                                      guide's attendance checklist
//   guide_trails                    -> which mountains each guide
//                                      may lead (admin-set)
// ==========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('email', '') in [
          'trailbound.philippines@gmail.com'
        ]
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'suspended')
      );
    }

    /* ---------- staff roles ----------
       One read of users/{uid}, reused by the helpers below.
       .get() with a default rather than bracket access, because an
       ordinary hiker's document has no role field at all and reading a
       missing field aborts the whole rule evaluation.

       A suspended account is nobody: the status check that already
       guards isAdmin() applies here too, so suspending someone in
       Admin -> Hikers actually locks them out of their staff screen
       rather than only hiding it in the UI.                          */

    function roleOf() {
      return signedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'suspended'
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
        : '';
    }

    function isOffice() {
      return roleOf() == 'permit_office';
    }

    function isGuide() {
      return roleOf() == 'guide';
    }

    // Which guide on the roster this account IS ('g1'…), or '' for
    // everyone else. The empty default matters: a booking with no guide
    // stores guideId null, and '' never equals null, so an unlinked
    // account can never accidentally match an unassigned hike.
    function myRosterId() {
      return isGuide()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('guideRosterId', '')
        : '';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The booking/order documents the site writes today have no uid
    // (booking.js and checkout.js both still carry a "TODO: add
    // user_id" comment). These rules accept a document either way,
    // so deploying them does NOT require the JS patches to land
    // first. Once uid is being written, ownership checks start
    // working on their own.
    //
    // TRADE-OFF, worth understanding: while a document has no uid,
    // this returns true for ANY signed-in user. So until the two
    // patches in INTEGRATION.md §3 land, any logged-in customer could
    // read another customer's booking or order if they guessed the
    // document id. That is strictly better than the current state
    // (where the rules are wide open) and it closes by itself as soon
    // as uid is being written. If you want it closed today, apply
    // those patches, backfill uid on existing documents, then delete
    // the two `!(field in resource.data)` lines below.
    function ownsUid() {
      return signedIn()
             && (!('uid' in resource.data)
                 || resource.data.uid == null
                 || resource.data.uid == request.auth.uid);
    }

    function emailMatches() {
      return signedIn()
             && 'email' in resource.data
             && resource.data.email == request.auth.token.email;
    }

    // Fields a customer must never set on their own profile — without
    // this, anyone could make themselves an admin.
    //
    // 'office' and 'guideRosterId' are in here for the same reason. A
    // guide who could edit guideRosterId would simply point it at a
    // colleague and read that colleague's hikes; an officer who could
    // edit 'office' would claim a different issuing body. Both are
    // granted by an admin in Admin -> Staff and nowhere else.
    function touchesPrivilegedFields() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(['role', 'disabled', 'status', 'office', 'guideRosterId']);
    }

    // Used by bookings/create. A new booking with no guide, or with a
    // guide not restricted to particular mountains (no guide_trails
    // document), passes exactly as before. A guide who IS restricted
    // can only be booked for one of their own mountains.
    function guideMayLeadTrail() {
      return request.resource.data.get('guideId', null) == null
        || !exists(/databases/$(database)/documents/guide_trails/$(request.resource.data.guideId))
        || request.resource.data.get('trailId', '')
             in get(/databases/$(database)/documents/guide_trails/$(request.resource.data.guideId)).data.get('trailIds', []);
    }

    /* ==========================================================
       ADMIN GATE
       The document that opens the whole panel. Never writable
       from a browser — add admins in the Firebase console.
       ========================================================== */

    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    /* ==========================================================
       BOOKING CATALOG — trails, guides, packages
       Read by booking.js and trail.html to build the form.
       Public read so the trails page works signed-out; only an
       admin can change what is bookable.
       ========================================================== */

    match /trails/{trailId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /guides/{guideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Booking page Step 03 (Accommodation). One "basecamp" document +
    // one document per partner hotel. Read by booking.js; written by
    // upload-accommodations.html and edited in the Firebase console,
    // so only an admin can change it.
    match /accommodations/{accommodationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ==========================================================
       GEAR — products
       Published gear is public so the shop renders for visitors.
       Inactive items are admin-only, which is why the customer
       side filters on status server-side.
       ========================================================== */

    // Public read, deliberately. products.js lists the whole
    // collection unfiltered (`getDocs(collection(db,"products"))`),
    // and Firestore evaluates a list query against every document it
    // could return — so a status-based read rule would fail the WHOLE
    // query as soon as one inactive item existed, blanking the shop.
    // Hiding inactive gear is therefore done in products.js instead;
    // see the patch in INTEGRATION.md.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Written from the product drawer. No auth on these yet — matching
    // how the page works today — but a review can never be edited or
    // removed from the browser once posted.
    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    /* ==========================================================
       BOOKINGS
       Written by the app's checkout (BookingService.confirm) with
       the hiker's uid.

       Four parties, three of them deliberately narrow:

         hiker    reads and creates only their own
         admin    reads all, changes anything
         office   reads only applications TrailBound has SENT them,
                  and changes only the permit decision
         guide    reads only hikes assigned to them, and changes
                  only whether the hiker turned up

       The office and guide clauses are what separation of duties
       actually means here. A stolen office account cannot confirm a
       hike or move money; a stolen guide account cannot change a
       price, a date or a permit. The UI hides those things too, but
       the UI is not what stops anyone.
       ========================================================== */

    match /bookings/{bookingId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.uid == request.auth.uid)
                  // The office sees an application only once it has been
                  // sent. Nothing in a basket, nothing abandoned at
                  // checkout, is ever visible to them.
                  || (isOffice() && resource.data.get('permitLodged', false) == true)
                  // A guide sees the hikes assigned to them. This is why
                  // the booking stores a roster id and not the guide's
                  // name: a rule can compare two stored fields, and could
                  // never compare a display name to an account.
                  || (isGuide() && myRosterId() != ''
                      && resource.data.get('guideId', '') == myRosterId());

      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && guideMayLeadTrail();

      allow update, delete: if isAdmin();

      // A hiker can only record the constrained demo checkout marker on
      // their own cleared, pending booking. It never changes real payment.
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && resource.data.get('status', '') == 'pending'
                    && resource.data.get('paperwork', '') == 'cleared'
                    && resource.data.get('payment', '') == 'balance_due'
                    && resource.data.get('demoBalancePaid', false) == false
                    && request.resource.data.demoBalancePaid == true
                    && request.resource.data.demoBalancePaidAt == request.time
                    && request.resource.data.demoBalancePaymentMethod
                         in ['Card', 'QRPh', 'Apple Pay', 'Maya']
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['demoBalancePaid', 'demoBalancePaidAt',
                                   'demoBalancePaymentMethod']);

      // The office decides the permit, and only the permit. Only from
      // 'permit_pending', and only to a final answer — an office cannot
      // un-decide, and cannot reach into anything else on the booking.
      allow update: if isOffice()
                    && resource.data.get('permitLodged', false) == true
                    && resource.data.get('paperwork', '') == 'permit_pending'
                    && request.resource.data.paperwork in ['cleared', 'denied']
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['paperwork', 'payment', 'permitRef', 'permitIssuedAt',
                                   'permitNote', 'balanceDueBy', 'updatedAt']);

      // The trailhead record, and nothing else. Only from 'confirmed':
      // a pending hike has not been arranged, so there is nothing to
      // turn up for, and a completed or cancelled one is already settled.
      allow update: if isGuide()
                    && myRosterId() != ''
                    && resource.data.get('guideId', '') == myRosterId()
                    && resource.data.get('status', '') == 'confirmed'
                    && request.resource.data.status in ['completed', 'no_show']
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'updatedAt']);
    }

    /* ==========================================================
       GUIDE AVAILABILITY & CAPACITY
       guide_status/{rosterId}  { available, maxGuests, updatedAt,
                                  updatedBy }

       Set by the guide on /guide. Public read, because the booking
       page shows it to signed-out visitors too and it holds nothing
       private. Only the guide whose roster id it is (or an admin)
       may write it, and only these four fields. maxGuests is null
       (no limit) or a whole number from 1 to 30, the same ceiling as
       a group booking.

       No document means available with no limit — how every guide
       behaved before this existed.
       ========================================================== */

    match /guide_status/{rosterId} {
      allow read: if true;
      allow create, update: if (isAdmin() || (isGuide() && myRosterId() == rosterId))
                            && request.resource.data.keys().hasOnly(
                                 ['available', 'maxGuests', 'updatedAt', 'updatedBy'])
                            && request.resource.data.available is bool
                            && (request.resource.data.maxGuests == null
                                || (request.resource.data.maxGuests is int
                                    && request.resource.data.maxGuests >= 1
                                    && request.resource.data.maxGuests <= 30))
                            && request.resource.data.updatedBy == request.auth.uid
                            && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    /* ==========================================================
       GUIDE-TO-MOUNTAIN ASSIGNMENT
       guide_trails/{rosterId}  { trailIds, updatedAt, updatedBy }

       Which mountains (trail ids) a guide may lead. Set by an admin
       in Admin -> Packages -> Guides; a guide cannot assign
       themselves. Public read, because the booking page only offers
       a guide on their own mountains, to signed-out visitors too.

       No document = not restricted yet: the guide is offered on
       every mountain, which is how every guide behaved before this
       existed. An admin lifts a restriction by deleting the document.
       ========================================================== */

    match /guide_trails/{rosterId} {
      allow read: if true;
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasOnly(['trailIds', 'updatedAt', 'updatedBy'])
                            && request.resource.data.trailIds is list
                            && request.resource.data.trailIds.size() >= 1
                            && request.resource.data.trailIds.size() <= 200
                            && request.resource.data.updatedBy == request.auth.uid
                            && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    /* ==========================================================
       HIKER ATTENDANCE
       attendance/{bookingId}  one checklist per booking

       Written ONLY by the guide the booking is assigned to (the
       booking's guideId is their roster id), and only once the
       booking is confirmed — or after it was closed as completed or
       no-show, so a mistake can be corrected. The document must name
       the same booking, the same hiker and the same guide, so it
       cannot be filed against someone else's booking.

       Admins read every record (the dashboard and booking drawer).
       A guide reads their own. Nobody else — not hikers, not other
       guides, not the permit office — can read or change one, and
       only an admin can delete one.

       The record backs up the existing no-show status, whose refund
       rule (not refundable) lives in booking-workflow.ts; nothing
       here changes that rule.
       ========================================================== */

    function attendanceBooking(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function guideOwnsBooking(bookingId) {
      return isGuide() && myRosterId() != ''
        && exists(/databases/$(database)/documents/bookings/$(bookingId))
        && attendanceBooking(bookingId).data.get('guideId', '') == myRosterId();
    }

    match /attendance/{bookingId} {
      allow read: if isAdmin()
                  || (isGuide() && myRosterId() != ''
                      && resource.data.get('guideId', '') == myRosterId());

      allow create, update: if guideOwnsBooking(bookingId)
                            && attendanceBooking(bookingId).data.get('status', '')
                                 in ['confirmed', 'completed', 'no_show']
                            && request.resource.data.keys().hasOnly(
                                 ['bookingId', 'uid', 'guideId', 'reference', 'trailName',
                                  'date', 'entries', 'recordedBy', 'updatedAt'])
                            && request.resource.data.bookingId == bookingId
                            && request.resource.data.guideId == myRosterId()
                            && request.resource.data.uid
                                 == attendanceBooking(bookingId).data.get('uid', '')
                            && request.resource.data.entries is map
                            && request.resource.data.entries.size() >= 1
                            && request.resource.data.entries.size() <= 30
                            && request.resource.data.recordedBy
                                 == request.auth.token.get('email', '')
                            && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    /* ==========================================================
       REVIEWS
       Written from a trail page by a signed-in hiker. Everyone can
       read them; the author or an admin can delete; nobody edits.
       ========================================================== */

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    /* ==========================================================
       TRAIL STATUS
       trail_status/{trailId} = { status: 'open'|'closed', note }.
       Set from Admin -> Trails; the app reads it to switch off
       booking on a closed trail.
       ========================================================== */

    match /trail_status/{trailId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-managed catalog additions are readable by signed-in hikers and
    // writable only by admins. Built-in catalog records remain in the app.
    match /catalog_trails/{trailId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /catalog_trail_overrides/{trailId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /catalog_packages/{packageId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /catalog_merch/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /catalog_guides/{guideId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    /* ==========================================================
       HIKING DOCUMENTS — medical certificate
       certificates/{uid}_{type}       status, reviewer's note
       certificate_files/{uid}_{type}  the file (data URL)

       One of each type per hiker; the id must match the hiker and
       the type. A hiker may upload or replace their own, but it
       always goes back to 'pending' — only an admin approves or
       rejects.

       A permit officer reads medical certificates, because fitness
       to climb is the basis on which they issue a permit. They can
       never write one: TrailBound's review decision is not theirs
       to change, and a document they could edit would be worthless
       as evidence.

       HONEST LIMITATION, worth knowing before anyone asks: this
       grants an officer read of ANY medical certificate, not only
       those attached to an application sent to them. Firestore
       cannot look up "does a lodged booking exist for this hiker"
       from a certificate id — rules cannot run queries. The
       compensating control is certificate_access below: every
       opening is logged with who, which and why.
       ========================================================== */

    function ownCertificateWrite(certId) {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type == 'medical'
        && certId == request.auth.uid + '_' + request.resource.data.type;
    }

    match /certificates/{certId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.uid == request.auth.uid)
                  || (isOffice() && resource.data.get('type', '') == 'medical');
      allow create, update: if ownCertificateWrite(certId)
                            && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /certificate_files/{certId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.uid == request.auth.uid)
                  || (isOffice() && resource.data.get('type', '') == 'medical');
      allow create, update: if ownCertificateWrite(certId);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    /* ==========================================================
       CERTIFICATE ACCESS LOG
       Append-only. Anyone who may read a certificate may add a line
       here; nobody can read it back through the app, and nobody at
       all can edit or delete one.

       `allow read: if false` applies to admins too, on purpose. A log
       that the people it watches can quietly tidy up is not a log.
       Read it in the Firebase console.
       ========================================================== */

    match /certificate_access/{entryId} {
      allow create: if signedIn()
                    && request.resource.data.openedBy == request.auth.token.get('email', '')
                    && request.resource.data.at == request.time;
      allow read, update, delete: if false;
    }

    /* ==========================================================
       ORDERS
       Written by checkout.js before the Maya redirect, then
       updated by payment-result.html when Maya sends the
       customer back — so the owner needs update rights here,
       not just the admin.
       ========================================================== */

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && ownsUid());
      allow create: if signedIn();
      allow update: if isAdmin() || (signedIn() && ownsUid());
      allow delete: if isAdmin();
    }

    /* ==========================================================
       SUPPORT MESSAGES
       contact.js lets guests submit, so create is open. Reading
       the inbox back is admin-only — these hold customer names,
       emails and order details.
       ========================================================== */

    match /contact/{messageId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    /* ==========================================================
       USERS
       ========================================================== */

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid)
                    && !request.resource.data.keys().hasAny(
                         ['role', 'status', 'disabled', 'office', 'guideRosterId']);
      allow update: if isAdmin() || (isOwner(uid) && !touchesPrivilegedFields());
      allow delete: if isAdmin();

      // Private to the customer, but an admin writes here too:
      // confirming a booking drops a notification into their account.
      match /notifications/{notificationId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /wishlist/{itemId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }
    }

    /* ==========================================================
       SITE SETTINGS
       World-readable so public pages can render the site name an
       admin typed, without anyone signing in first.
       ========================================================== */

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ==========================================================
       ACTIVITY FEED
       Customers append to it implicitly (booking, sign-up); only
       admins read the log back.
       ========================================================== */

    match /activity/{entryId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    /* ==========================================================
       COMMUNITY — posts, comments, public profiles

       posts/{id}  one post. A repost is also a post (repostOf = the
                   original's id; its id is repost_<uid>_<originalId>).
         likedBy      uids who UPVOTED (the old "likes" list)
         downvotedBy  uids who downvoted
         repostedBy   uids who reposted
         rating       1-5 stars for the tagged trail (optional)
       ========================================================== */

    // Every uid in `after` that is not in `before`, and every uid that
    // was removed, must be the signed-in user. So you can only add or
    // remove YOURSELF from a vote / repost list.
    function onlySelfChanged(before, after) {
      return after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
          && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]);
    }

    // What any signed-in user may do to someone else's post: vote,
    // repost, and move the comment counter by one.
    function engagementOnly() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likedBy', 'downvotedBy', 'repostedBy', 'commentCount'])
        && onlySelfChanged(resource.data.get('likedBy', []),
                           request.resource.data.get('likedBy', []))
        && onlySelfChanged(resource.data.get('downvotedBy', []),
                           request.resource.data.get('downvotedBy', []))
        && onlySelfChanged(resource.data.get('repostedBy', []),
                           request.resource.data.get('repostedBy', []))
        && (request.resource.data.get('commentCount', 0)
            - resource.data.get('commentCount', 0)) in [-1, 0, 1];
    }

    function validRating() {
      return !('rating' in request.resource.data)
        || (request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5);
    }

    // A tagged guide must be somebody else who has a public profile.
    function validGuide() {
      return !('guideUid' in request.resource.data)
        || (request.resource.data.guideUid is string
            && request.resource.data.guideUid != request.resource.data.authorUid
            && exists(/databases/$(database)/documents/profiles/$(request.resource.data.guideUid)));
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && validRating()
                    && validGuide();

      // The author edits their own post (but can never reassign it);
      // anyone signed in may vote / repost / bump the comment counter.
      allow update: if (signedIn()
                        && resource.data.authorUid == request.auth.uid
                        && request.resource.data.authorUid == resource.data.authorUid
                        && validRating()
                        && validGuide())
                    || engagementOnly()
                    || isAdmin();

      allow delete: if isOwner(resource.data.authorUid) || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
                      && request.resource.data.authorUid == request.auth.uid;
        allow update: if false;
        // You can delete your own comment, and the post's author can
        // delete any comment on their post.
        allow delete: if isAdmin()
                      || (signedIn()
                          && (resource.data.authorUid == request.auth.uid
                              || get(/databases/$(database)/documents/posts/$(postId))
                                   .data.authorUid == request.auth.uid));
      }

      // Earlier versions of the post. Anyone can read them; only the
      // post's author can add one (when editing) or remove them (when
      // deleting the post). They can never be changed.
      match /history/{versionId} {
        allow read: if true;
        allow create: if signedIn()
                      && request.resource.data.authorUid == request.auth.uid
                      && get(/databases/$(database)/documents/posts/$(postId))
                           .data.authorUid == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin()
                      || (signedIn()
                          && get(/databases/$(database)/documents/posts/$(postId))
                               .data.authorUid == request.auth.uid);
      }
    }

    // ---- follows ----
    // follows/{followerUid}_{followeeUid}. You can only create or delete a
    // follow where YOU are the follower, and never follow yourself. The id
    // must match the two uids, so there can be only one per pair.
    match /follows/{followId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.followerUid == request.auth.uid
                    && request.resource.data.followeeUid is string
                    && request.resource.data.followeeUid != request.auth.uid
                    && followId == request.auth.uid + '_' + request.resource.data.followeeUid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
    }

    /* ==========================================================
       ANYTHING ELSE
       Denied. If you add a collection, add a block for it above —
       this line is what would otherwise silently break it.
       ========================================================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
