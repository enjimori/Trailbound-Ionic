rules_version = '2';

// ==========================================================
// Trailbound — Firestore security rules (trailbound-ionic)
// ----------------------------------------------------------
// Deploy:  firebase deploy --only firestore:rules
//   or paste into Firebase console -> Firestore Database ->
//   Rules -> Publish.
//
// ADMIN PANEL (/admin) — what changed in this version
//   * isAdmin() now recognises the built-in admin login
//     (username "admin" = admin@trailbound-ionic.firebaseapp.com),
//     anyone in admins/{uid}, and any hiker promoted from
//     Admin -> Hikers (users/{uid}.role == 'admin').
//   * A hiker can never give themselves role or status, on
//     create or update, so nobody can self-promote or
//     un-suspend themselves.
//   * bookings: each booking carries the hiker's uid. A hiker
//     reads and creates only their own; only an admin changes
//     or deletes one.
//   * reviews, trail_status, certificates and certificate_files:
//     new collections (certificates = medical certificate and
//     barangay clearance uploads, reviewed by an admin).
//   * An admin may remove any post, comment or edit history.
//
// To add another built-in admin email, add it to the list in
// isAdmin() below AND to ADMIN_ACCOUNTS in
// src/app/pages/admin/admin.config.ts.
//
// IMPORTANT — this REPLACES the earlier version of this file.
// That one only knew about products, bookings, users, settings
// and activity, so its closing `allow read, write: if false`
// silently blocked trails, guides, packages, orders and contact.
// Deploying it would have broken the booking page and checkout.
// Every collection the site actually touches is covered below.
//
// Collections, and who each one is for:
//
//   trails     guides    packages   -> the booking page's three
//                                      dropdowns. Public read.
//   accommodations                  -> booking page Step 03:
//                                      basecamp + partner hotels.
//                                      Public read. (ADDED)
//   products                        -> gear in the shop. Public
//                                      read when active.
//   bookings                        -> a reserved trail slot.
//   orders                          -> a paid gear/checkout order.
//   contact                         -> support messages.
//   users  (+ wishlist, notifications)
//   settings   activity   admins
// ==========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('email', '') in [
          'admin@trailbound-ionic.firebaseapp.com'
        ]
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'suspended')
      );
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The booking/order documents the site writes today have no uid
    // (booking.js and checkout.js both still carry a "TODO: add
    // user_id" comment). These rules accept a document either way,
    // so deploying them does NOT require the JS patches to land
    // first. Once uid is being written, ownership checks start
    // working on their own.
    //
    // TRADE-OFF, worth understanding: while a document has no uid,
    // this returns true for ANY signed-in user. So until the two
    // patches in INTEGRATION.md §3 land, any logged-in customer could
    // read another customer's booking or order if they guessed the
    // document id. That is strictly better than the current state
    // (where the rules are wide open) and it closes by itself as soon
    // as uid is being written. If you want it closed today, apply
    // those patches, backfill uid on existing documents, then delete
    // the two `!(field in resource.data)` lines below.
    // REWRITTEN: this took a field name as a parameter and read it back
    // with resource.data[field] — bracket access with a VARIABLE key,
    // which the rules language does not reliably compile. A ruleset that
    // fails to compile is rejected wholesale and your previous rules stay
    // live, so the symptom is "I published and nothing changed".
    // Literal field access only now.
    function ownsUid() {
      return signedIn()
             && (!('uid' in resource.data)
                 || resource.data.uid == null
                 || resource.data.uid == request.auth.uid);
    }

    function emailMatches() {
      return signedIn()
             && 'email' in resource.data
             && resource.data.email == request.auth.token.email;
    }

    // Fields a customer must never set on their own profile —
    // without this, anyone could make themselves an admin.
    function touchesPrivilegedFields() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(['role', 'disabled', 'status']);
    }

    /* ==========================================================
       ADMIN GATE
       The document that opens the whole panel. Never writable
       from a browser — add admins in the Firebase console.
       ========================================================== */

    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    /* ==========================================================
       BOOKING CATALOG — trails, guides, packages
       Read by booking.js and trail.html to build the form.
       Public read so the trails page works signed-out; only an
       admin can change what is bookable.
       ========================================================== */

    match /trails/{trailId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /guides/{guideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ADDED — booking page Step 03 (Accommodation).
    // One "basecamp" document + one document per partner hotel.
    // Read by booking.js; written by upload-accommodations.html and
    // edited in the Firebase console, so only an admin can change it.
    match /accommodations/{accommodationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ==========================================================
       GEAR — products
       Published gear is public so the shop renders for visitors.
       Inactive items are admin-only, which is why the customer
       side filters on status server-side.
       ========================================================== */

    // Public read, deliberately. products.js lists the whole
    // collection unfiltered (`getDocs(collection(db,"products"))`),
    // and Firestore evaluates a list query against every document it
    // could return — so a status-based read rule would fail the WHOLE
    // query as soon as one inactive item existed, blanking the shop.
    // Hiding inactive gear is therefore done in products.js instead;
    // see the patch in INTEGRATION.md.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Written from the product drawer. No auth on these yet — matching
    // how the page works today — but a review can never be edited or
    // removed from the browser once posted.
    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    /* ==========================================================
       BOOKINGS
       Written by the app's checkout (BookingService.confirm) with
       the hiker's uid. A hiker reads and creates only their own;
       the admin panel reads them all and is the only one that can
       change a status (completed / cancelled) or delete one.
       ========================================================== */

    match /bookings/{bookingId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    /* ==========================================================
       REVIEWS
       Written from a trail page by a signed-in hiker. Everyone can
       read them; the author or an admin can delete; nobody edits.
       ========================================================== */

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    /* ==========================================================
       TRAIL STATUS
       trail_status/{trailId} = { status: 'open'|'closed', note }.
       Set from Admin -> Trails; the app reads it to switch off
       booking on a closed trail.
       ========================================================== */

    match /trail_status/{trailId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ==========================================================
       HIKING DOCUMENTS — medical certificate + barangay clearance
       certificates/{uid}_{type}       status, reviewer's note
       certificate_files/{uid}_{type}  the file (data URL)
       One of each type per hiker; the id must match the hiker and
       the type. A hiker may upload or replace their own, but it
       always goes back to 'pending' — only an admin approves or
       rejects. Nobody but the hiker and admins can read them.
       ========================================================== */

    function ownCertificateWrite(certId) {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['medical', 'barangay']
        && certId == request.auth.uid + '_' + request.resource.data.type;
    }

    match /certificates/{certId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if ownCertificateWrite(certId)
                            && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /certificate_files/{certId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if ownCertificateWrite(certId);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    /* ==========================================================
       ORDERS
       Written by checkout.js before the Maya redirect, then
       updated by payment-result.html when Maya sends the
       customer back — so the owner needs update rights here,
       not just the admin.
       ========================================================== */

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && ownsUid());
      allow create: if signedIn();
      allow update: if isAdmin() || (signedIn() && ownsUid());
      allow delete: if isAdmin();
    }

    /* ==========================================================
       SUPPORT MESSAGES
       contact.js lets guests submit, so create is open. Reading
       the inbox back is admin-only — these hold customer names,
       emails and order details.
       ========================================================== */

    match /contact/{messageId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    /* ==========================================================
       USERS
       ========================================================== */

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid)
                    && !request.resource.data.keys().hasAny(['role', 'status', 'disabled']);
      allow update: if isAdmin() || (isOwner(uid) && !touchesPrivilegedFields());
      allow delete: if isAdmin();

      // Private to the customer, but an admin writes here too:
      // confirming a booking drops a notification into their account.
      match /notifications/{notificationId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /wishlist/{itemId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }
    }

    /* ==========================================================
       SITE SETTINGS
       World-readable so public pages can render the site name an
       admin typed, without anyone signing in first.
       ========================================================== */

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ==========================================================
       ACTIVITY FEED
       Customers append to it implicitly (booking, sign-up); only
       admins read the log back.
       ========================================================== */

    match /activity/{entryId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    /* ==========================================================
       COMMUNITY — posts, comments, public profiles
       ADDED. The rules file you sent had no block for these, so the
       catch-all at the bottom was denying them. If your LIVE rules
       already have posts/profiles blocks (e.g. in another file),
       merge this in instead of pasting it twice.

       posts/{id}  one post. A repost is also a post (repostOf = the
                   original's id; its id is repost_<uid>_<originalId>).
         likedBy      uids who UPVOTED (the old "likes" list)
         downvotedBy  uids who downvoted
         repostedBy   uids who reposted
         rating       1-5 stars for the tagged trail (optional)
       ========================================================== */

    // Every uid in `after` that is not in `before`, and every uid that
    // was removed, must be the signed-in user. So you can only add or
    // remove YOURSELF from a vote / repost list.
    function onlySelfChanged(before, after) {
      return after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
          && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]);
    }

    // What any signed-in user may do to someone else's post: vote,
    // repost, and move the comment counter by one.
    function engagementOnly() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likedBy', 'downvotedBy', 'repostedBy', 'commentCount'])
        && onlySelfChanged(resource.data.get('likedBy', []),
                           request.resource.data.get('likedBy', []))
        && onlySelfChanged(resource.data.get('downvotedBy', []),
                           request.resource.data.get('downvotedBy', []))
        && onlySelfChanged(resource.data.get('repostedBy', []),
                           request.resource.data.get('repostedBy', []))
        && (request.resource.data.get('commentCount', 0)
            - resource.data.get('commentCount', 0)) in [-1, 0, 1];
    }

    function validRating() {
      return !('rating' in request.resource.data)
        || (request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5);
    }

    // A tagged guide must be somebody else who has a public profile.
    function validGuide() {
      return !('guideUid' in request.resource.data)
        || (request.resource.data.guideUid is string
            && request.resource.data.guideUid != request.resource.data.authorUid
            && exists(/databases/$(database)/documents/profiles/$(request.resource.data.guideUid)));
    }

    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && validRating()
                    && validGuide();

      // The author edits their own post (but can never reassign it);
      // anyone signed in may vote / repost / bump the comment counter.
      allow update: if (signedIn()
                        && resource.data.authorUid == request.auth.uid
                        && request.resource.data.authorUid == resource.data.authorUid
                        && validRating()
                        && validGuide())
                    || engagementOnly()
                    || isAdmin();

      allow delete: if isOwner(resource.data.authorUid) || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
                      && request.resource.data.authorUid == request.auth.uid;
        allow update: if false;
        // You can delete your own comment, and the post's author can
        // delete any comment on their post.
        allow delete: if isAdmin()
                      || (signedIn()
                          && (resource.data.authorUid == request.auth.uid
                              || get(/databases/$(database)/documents/posts/$(postId))
                                   .data.authorUid == request.auth.uid));
      }

      // Earlier versions of the post. Anyone can read them; only the
      // post's author can add one (when editing) or remove them (when
      // deleting the post). They can never be changed.
      match /history/{versionId} {
        allow read: if true;
        allow create: if signedIn()
                      && request.resource.data.authorUid == request.auth.uid
                      && get(/databases/$(database)/documents/posts/$(postId))
                           .data.authorUid == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin()
                      || (signedIn()
                          && get(/databases/$(database)/documents/posts/$(postId))
                               .data.authorUid == request.auth.uid);
      }
    }

    // ---- follows ----
    // follows/{followerUid}_{followeeUid}. You can only create or delete a
    // follow where YOU are the follower, and never follow yourself. The id
    // must match the two uids, so there can be only one per pair.
    match /follows/{followId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.followerUid == request.auth.uid
                    && request.resource.data.followeeUid is string
                    && request.resource.data.followeeUid != request.auth.uid
                    && followId == request.auth.uid + '_' + request.resource.data.followeeUid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
    }

    /* ==========================================================
       ANYTHING ELSE
       Denied. If you add a collection, add a block for it above —
       this line is what would otherwise silently break it.
       ========================================================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
